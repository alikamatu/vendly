# API Connection
NEXT_PUBLIC_API_URL=http://localhost:1000
API_URL=http://localhost:1000

# ─── SEO / canonical site URL ─────────────────────────────────────────
# The public, canonical origin. EVERY canonical tag, OG/Twitter URL,
# sitemap entry, robots host, and JSON-LD URL derives from this. Must be
# the exact production origin with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://verndly.com

# Search-engine ownership verification (paste the token only, not the full
# meta tag). Needed to verify the domain and submit the sitemap.
#   Google Search Console -> https://search.google.com/search-console
#   Bing Webmaster Tools  -> https://www.bing.com/webmasters
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Public support / contact details ─────────────────────────────────
# Single source of truth surfaced across the site (contact page, footer,
# help pages, JSON-LD). Phone is the human-readable form; tel:/wa.me links
# are derived from it automatically (see lib/contact.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=support@verndly.com
NEXT_PUBLIC_SUPPORT_PHONE=+233 53 406 5652

# ─── Sentry error monitoring ──────────────────────────────────────────
# Browser SDK reads NEXT_PUBLIC_SENTRY_DSN; server runtime reads either
# SENTRY_DSN or NEXT_PUBLIC_SENTRY_DSN. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time source-map upload (set on Vercel, not committed).
# Required for readable stack traces in Sentry instead of minified.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
