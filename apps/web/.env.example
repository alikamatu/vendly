# API Connection
NEXT_PUBLIC_API_URL=http://localhost:1000
API_URL=http://localhost:1000

# ─── Sentry error monitoring ──────────────────────────────────────────
# Browser SDK reads NEXT_PUBLIC_SENTRY_DSN; server runtime reads either
# SENTRY_DSN or NEXT_PUBLIC_SENTRY_DSN. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time source-map upload (set on Vercel, not committed).
# Required for readable stack traces in Sentry instead of minified.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
