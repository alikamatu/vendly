# Base URL of the Verndly API.
# Defaults to the live production API so real marketplace data loads on any device.
# To point at a local API server on your LAN instead, set e.g. http://192.168.1.20:1000
EXPO_PUBLIC_API_URL=https://vendly-lfr6.onrender.com

# Public storefront web URL
EXPO_PUBLIC_WEB_URL=https://verndly.com
