generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String          @id @default(uuid()) @db.Uuid
  full_name                  String
  email                      String          @unique
  password_hash              String
  school                     String
  is_verified                Boolean         @default(false)
  verification_doc           String?
  role                       Role            @default(USER)
  email_verification_token   String?         @unique
  email_verification_expires DateTime?
  password_reset_token       String?         @unique
  password_reset_expires     DateTime?
  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt
  is_suspended               Boolean         @default(false)
  warnings                   Int             @default(0)
  is_pro                     Boolean         @default(false)
  pro_expires_at             DateTime?
  reviewed_approvals         AdminApproval[] @relation("ReviewedBy")
  admin_approvals            AdminApproval[]
  favorites                  Favorite[]
  orders                     Order[]         @relation("BuyerOrders")
  seller_profile             SellerProfile?
  reviews                    Review[]        @relation("BuyerReviews")
  review_flags               ReviewFlag[]    @relation("FlagsCreated")

  @@map("users")
}

model SellerProfile {
  id                       String                    @id @default(uuid()) @db.Uuid
  user_id                  String                    @unique @db.Uuid
  store_name               String
  store_link               String                    @unique
  logo_url                 String?
  bio                      String?
  whatsapp_number          String?
  location                 String?
  location_id              String?                   @db.Uuid
  area                     String?
  latitude                 Decimal?                  @db.Decimal(10, 7)
  longitude                Decimal?                  @db.Decimal(10, 7)
  delivery_policies        String?
  business_hours           String?
  social_links             Json?                     @default("{}")
  bank_name                String?
  bank_code                String?
  account_number           String?
  paystack_subaccount_code String?
  onboarding_completed     Boolean                   @default(false)
  store_profile_completed  Boolean                   @default(false)
  location_set             Boolean                   @default(false)
  payment_setup_completed  Boolean                   @default(false)
  accepted_payment_methods String[]                  @default([])
  payment_timing           PaymentTiming?
  service_area             ServiceArea?
  avg_delivery_time        DeliveryTime?
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt
  products                 Product[]
  promotion_payments       ProductPromotionPayment[]
  payouts                  Payout[]
  ledger_entries           PaymentLedgerEntry[]
  balance_snapshot         VendorBalanceSnapshot?
  user                     User                      @relation(fields: [user_id], references: [id])
  structured_location      Location?                 @relation(fields: [location_id], references: [id])
  reviews                  Review[]                  @relation("SellerReviews")

  /// Denormalized ratings — recalculated on review write/delete.
  rating_avg   Float @default(0)
  rating_count Int   @default(0)

  @@map("seller_profiles")
}

model SubaccountRetry {
  id         String   @id @default(uuid()) @db.Uuid
  seller_id  String   @db.Uuid
  attempts   Int      @default(0)
  last_error String?
  status     String   @default("PENDING")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("subaccount_retries")
}

model Product {
  id                 String                    @id @default(uuid()) @db.Uuid
  seller_id          String                    @db.Uuid
  title              String
  description        String?
  price              Decimal                   @db.Decimal(10, 2)
  original_price     Decimal?                  @db.Decimal(10, 2)
  currency           String                    @default("GHS") @db.VarChar(3)
  condition          String                    @default("new") @db.VarChar(20)
  quantity_available Int                       @default(1)
  status             String                    @default("draft") @db.VarChar(20)
  is_featured        Boolean                   @default(false)
  views_count        Int                       @default(0)
  category           String
  brand              String?                   @db.VarChar(100)
  attributes         Json?                     @default("{}")
  image_urls         String[]                  @default([])
  video_url          String?
  tags               String[]                  @default([])
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt
  favorited_by       Favorite[]
  order_items        OrderItem[]
  promotion_payments ProductPromotionPayment[]
  seller             SellerProfile             @relation(fields: [seller_id], references: [id])
  reviews            Review[]                  @relation("ProductReviews")

  /// Denormalized ratings — recalculated on review write/delete.
  rating_avg   Float @default(0)
  rating_count Int   @default(0)

  @@index([category])
  @@index([seller_id, title])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@index([rating_avg])
  @@map("products")
}

model ProductPromotionPayment {
  id           String                   @id @default(uuid()) @db.Uuid
  seller_id    String                   @db.Uuid
  product_id   String                   @db.Uuid
  reference    String                   @unique
  category     PromotionPaymentCategory @default(BOOST)
  amount       Decimal                  @db.Decimal(10, 2)
  currency     String                   @default("GHS") @db.VarChar(3)
  status       PromotionPaymentStatus   @default(PENDING)
  provider_ref String?
  paid_at      DateTime?
  consumed_at  DateTime?
  created_at   DateTime                 @default(now())
  updated_at   DateTime                 @updatedAt
  product      Product                  @relation(fields: [product_id], references: [id])
  seller       SellerProfile            @relation(fields: [seller_id], references: [id])

  @@index([seller_id, status])
  @@index([product_id, status])
  @@map("product_promotion_payments")
}

model Order {
  id                String       @id @default(uuid()) @db.Uuid
  buyer_id          String       @db.Uuid
  total_amount      Decimal      @db.Decimal(10, 2)
  status            String       @default("PENDING")
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  customer_name     String?
  customer_phone    String?
  delivery_location String?
  delivery_method   String?
  delivery_notes    String?
  items             OrderItem[]
  transaction       Transaction?
  buyer             User         @relation("BuyerOrders", fields: [buyer_id], references: [id])

  @@map("orders")
}

model Transaction {
  id             String               @id @default(uuid()) @db.Uuid
  order_id       String               @unique @db.Uuid
  reference      String               @unique
  amount         Decimal              @db.Decimal(10, 2)
  status         String               @default("PENDING")
  provider       String               @default("PAYSTACK")
  provider_ref   String?
  metadata       Json?                @default("{}")
  payout_status  PayoutStatus         @default(PENDING)
  reconciled_at  DateTime?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  order          Order                @relation(fields: [order_id], references: [id])
  payout         Payout?
  ledger_entries PaymentLedgerEntry[]

  @@map("transactions")
}

model PaymentLog {
  id         String   @id @default(uuid()) @db.Uuid
  event      String
  event_id   String?  @unique
  payload    Json
  created_at DateTime @default(now())

  @@map("payment_logs")
}

model Payout {
  id             String               @id @default(uuid()) @db.Uuid
  seller_id      String               @db.Uuid
  transaction_id String?              @unique @db.Uuid
  reference      String               @unique
  amount         Decimal              @db.Decimal(10, 2)
  currency       String               @default("GHS") @db.VarChar(3)
  mode           PayoutMode           @default(AUTO)
  status         PayoutStatus         @default(PENDING)
  provider       String               @default("PAYSTACK")
  provider_ref   String?
  failure_reason String?
  metadata       Json?                @default("{}")
  processed_at   DateTime?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  seller         SellerProfile        @relation(fields: [seller_id], references: [id])
  transaction    Transaction?         @relation(fields: [transaction_id], references: [id])
  ledger_entries PaymentLedgerEntry[]

  @@index([seller_id, status, created_at])
  @@index([status, mode, created_at])
  @@map("payouts")
}

model PaymentLedgerEntry {
  id             String           @id @default(uuid()) @db.Uuid
  seller_id      String           @db.Uuid
  transaction_id String?          @db.Uuid
  payout_id      String?          @db.Uuid
  reference      String           @unique
  type           LedgerEntryType
  source_type    LedgerSourceType
  amount         Decimal          @db.Decimal(10, 2)
  currency       String           @default("GHS") @db.VarChar(3)
  description    String?
  metadata       Json?            @default("{}")
  created_at     DateTime         @default(now())
  seller         SellerProfile    @relation(fields: [seller_id], references: [id])
  transaction    Transaction?     @relation(fields: [transaction_id], references: [id])
  payout         Payout?          @relation(fields: [payout_id], references: [id])

  @@index([seller_id, created_at])
  @@index([seller_id, source_type, created_at])
  @@map("payment_ledger_entries")
}

model VendorBalanceSnapshot {
  id                String        @id @default(uuid()) @db.Uuid
  seller_id         String        @unique @db.Uuid
  available_balance Decimal       @default(0) @db.Decimal(10, 2)
  pending_balance   Decimal       @default(0) @db.Decimal(10, 2)
  total_earned      Decimal       @default(0) @db.Decimal(10, 2)
  total_withdrawn   Decimal       @default(0) @db.Decimal(10, 2)
  currency          String        @default("GHS") @db.VarChar(3)
  updated_at        DateTime      @updatedAt
  seller            SellerProfile @relation(fields: [seller_id], references: [id])

  @@map("vendor_balance_snapshots")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  order_id   String  @db.Uuid
  product_id String  @db.Uuid
  quantity   Int
  price      Decimal @db.Decimal(10, 2)
  order      Order   @relation(fields: [order_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
  review     Review?

  @@map("order_items")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  image_url   String?
  fields      Json?    @default("[]")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  brands      Brand[]

  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  image_url   String?
  category_id String   @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([name, category_id])
  @@map("brands")
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  @@map("platform_settings")
}

model AdminApproval {
  id                String           @id @default(uuid()) @db.Uuid
  user_id           String           @db.Uuid
  status            ApprovalStatus   @default(PENDING)
  type              VerificationType @default(FILES)
  verification_data String?          @db.Text
  reviewed_by       String?          @db.Uuid
  reviewed_at       DateTime?
  created_at        DateTime         @default(now())
  reviewer          User?            @relation("ReviewedBy", fields: [reviewed_by], references: [id])
  user              User             @relation(fields: [user_id], references: [id])

  @@map("admin_approvals")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now())
  product    Product  @relation(fields: [product_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, product_id])
  @@map("favorites")
}

/// Buyer-authored review of a purchased product.
/// One review per (buyer, order_item) — meaning each unit you bought
/// is reviewable exactly once. Sellers may attach a single reply.
model Review {
  id            String @id @default(uuid()) @db.Uuid
  product_id    String @db.Uuid
  seller_id     String @db.Uuid
  buyer_id      String @db.Uuid
  order_item_id String @unique @db.Uuid

  rating Int // 1..5, validated server-side
  title  String? @db.VarChar(140)
  body   String?

  /// Soft-moderation states. PUBLISHED is visible; HIDDEN was removed by
  /// the buyer or staff; FLAGGED is awaiting moderator review.
  status ReviewStatus @default(PUBLISHED)

  /// Set true when the order item is verified delivered at review time.
  verified_purchase Boolean @default(true)

  helpful_count Int @default(0)

  seller_reply      String?
  seller_replied_at DateTime?

  edited_at  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  product    Product       @relation("ProductReviews", fields: [product_id], references: [id])
  seller     SellerProfile @relation("SellerReviews", fields: [seller_id], references: [id])
  buyer      User          @relation("BuyerReviews", fields: [buyer_id], references: [id])
  order_item OrderItem     @relation(fields: [order_item_id], references: [id])
  flags      ReviewFlag[]

  @@index([product_id, status, created_at(sort: Desc)])
  @@index([seller_id, status, created_at(sort: Desc)])
  @@index([buyer_id, created_at(sort: Desc)])
  @@map("reviews")
}

/// A single user can flag a review once. Sellers cannot flag reviews of
/// their own products (enforced in the service).
model ReviewFlag {
  id          String           @id @default(uuid()) @db.Uuid
  review_id   String           @db.Uuid
  reporter_id String           @db.Uuid
  reason      ReviewFlagReason
  notes       String?
  created_at  DateTime         @default(now())
  review      Review           @relation(fields: [review_id], references: [id], onDelete: Cascade)
  reporter    User             @relation("FlagsCreated", fields: [reporter_id], references: [id])

  @@unique([review_id, reporter_id])
  @@index([review_id])
  @@map("review_flags")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum ReviewFlagReason {
  SPAM
  OFFENSIVE
  IRRELEVANT
  FAKE
  OTHER
}

model Location {
  id              String          @id @default(uuid()) @db.Uuid
  country         String          @default("Ghana")
  region          String
  city            String
  slug            String          @unique
  created_at      DateTime        @default(now())
  seller_profiles SellerProfile[]

  @@unique([country, region, city])
  @@index([region])
  @@map("locations")
}

enum Role {
  USER
  ADMIN
  SELLER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentTiming {
  UPFRONT_ONLY
  DELIVERY_ONLY
  BOTH
}

enum VerificationType {
  URL
  FILES
  CONTACT
}

enum PromotionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PromotionPaymentCategory {
  BOOST
  PLAN
}

enum PayoutMode {
  AUTO
  MANUAL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerSourceType {
  ORDER
  PROMOTION
  ADJUSTMENT
  FEE
  PAYOUT
}

enum ServiceArea {
  SAME_CITY
  NEARBY_STATES
  NATIONWIDE
}

enum DeliveryTime {
  SAME_DAY
  NEXT_DAY
  TWO_TO_THREE_DAYS
  FOUR_TO_SEVEN_DAYS
  MORE_THAN_ONE_WEEK
}
