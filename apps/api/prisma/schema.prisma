generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma.config.ts for Prisma v7+
}


enum Role {
  USER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                        BigInt      @id @default(autoincrement())
  full_name                 String
  email                     String      @unique
  password_hash             String
  school                    String
  is_verified               Boolean     @default(false)
  verification_doc          String?
  role                      Role        @default(USER)
  email_verification_token  String?     @unique
  email_verification_expires DateTime?
  password_reset_token      String?     @unique
  password_reset_expires    DateTime?
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt

  seller_profile    SellerProfile?
  admin_approvals   AdminApproval[]
  reviewed_approvals AdminApproval[] @relation("ReviewedBy")
}

model SellerProfile {
  id                BigInt      @id @default(autoincrement())
  user_id           BigInt      @unique
  store_name        String
  store_link        String      @unique
  bio               String?
  whatsapp_number   String?     // added for WhatsApp contact
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  user              User        @relation(fields: [user_id], references: [id])
  products          Product[]
}

model Product {
  id                BigInt      @id @default(autoincrement())
  seller_id         BigInt
  title             String
  description       String?
  price             Decimal     @db.Decimal(10,2)
  category          String      // indexed for search
  image_url         String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  seller            SellerProfile @relation(fields: [seller_id], references: [id])

  @@index([category])
}

model Category {
  id                BigInt      @id @default(autoincrement())
  name              String      @unique
  description       String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
}

model AdminApproval {
  id                BigInt      @id @default(autoincrement())
  user_id           BigInt
  status            ApprovalStatus @default(PENDING)
  reviewed_by       BigInt?     // admin user id
  reviewed_at       DateTime?
  created_at        DateTime    @default(now())

  user              User        @relation(fields: [user_id], references: [id])
  reviewer          User?       @relation("ReviewedBy", fields: [reviewed_by], references: [id])
}