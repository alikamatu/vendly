# Database Connection
# DATABASE_URL is for PGBouncer connection (e.g., Supabase)
DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"
# DIRECT_URL is for direct database connection
DIRECT_URL="postgresql://user:password@host:port/dbname"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Email Service (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# App URLs
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000"
BACKEND_URL="http://localhost:1000"
PORT=1000

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_BASE_URL="https://api.paystack.co"

# Google OAuth
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# SMS Provider (Arkesel)
ARKESEL_API_KEY="..."
ARKESEL_SENDER_ID="Vendly"
ARKESEL_SANDBOX="false"

# Admin notification target for seller verification submissions
ADMIN_NOTIFY_EMAIL="admin@example.com"
ADMIN_NOTIFY_PHONE="+233000000000"

# Sentry — leave SENTRY_DSN empty to disable error monitoring entirely.
# Get DSN from Sentry project settings → Client Keys (DSN).
SENTRY_DSN=""
# Optional; defaults to NODE_ENV
SENTRY_ENVIRONMENT=""
# Optional; tag every event with a release version
SENTRY_RELEASE=""
# 0..1 — share of transactions sent to Sentry for performance traces
SENTRY_TRACES_SAMPLE_RATE="0.1"
# 0..1 — CPU profiles. 0 to disable (default; double cost otherwise).
SENTRY_PROFILES_SAMPLE_RATE="0"

# Cron Jobs
CRON_SECRET="your-cron-secret-key"
