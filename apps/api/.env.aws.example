# ============================================================
# Vendly API — AWS Environment Variables
# Copy this to .env and fill in real values.
# Never commit the real .env to git.
# ============================================================

# ── Database (Amazon RDS PostgreSQL) ──────────────────────────
DATABASE_URL="postgresql://vendly_user:STRONG_PASSWORD@vendly-db.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com:5432/vendly?schema=public&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://vendly_user:STRONG_PASSWORD@vendly-db.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com:5432/vendly?schema=public"

# ── Cache (Amazon ElastiCache Redis) ──────────────────────────
REDIS_URL="rediss://vendly-cache.xxxxxx.cfg.eu-west-1.cache.amazonaws.com:6379"

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET="replace-with-64-char-random-secret"
JWT_EXPIRES_IN="7d"

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ── App URLs ───────────────────────────────────────────────────
FRONTEND_URL="https://your-amplify-app.amplifyapp.com"
ADMIN_URL="https://your-admin-amplify-app.amplifyapp.com"
BACKEND_URL="https://your-app-runner-service.eu-west-1.awsapprunner.com"
PORT=1000

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ── Paystack ───────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_BASE_URL="https://api.paystack.co"

# ── AWS Region ─────────────────────────────────────────────────
AWS_REGION="eu-west-1"
